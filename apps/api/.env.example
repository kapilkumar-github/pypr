# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Supabase Postgres (direct connection, needs IPv6). Supabase dashboard -> Connect -> Direct.
# uselibpqcompat makes sslmode=require mean "encrypt" as in psql; it doesn't verify the certificate.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true
# Or the local Docker database (`pnpm db:up`):
# DATABASE_URL=postgresql://pypr:pypr@localhost:5432/pypr_dev
# HMAC key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Web origins allowed to send requests that change data (comma-separated)
WEB_ORIGINS=http://localhost:3000
# Proxies trusted for the client IP used by rate limits (the Next.js dev proxy is loopback)
TRUST_PROXY=loopback
# Base URL of the web app, used in emailed links
APP_URL=http://localhost:3000
# Email adapter: "console" (logs emails, local only) or "resend"
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender; the domain must be verified in Resend
EMAIL_FROM=Pypr <no-reply@send.pypr.work>
# AI resume import: "openrouter" or "disabled" (default). See docs/decisions.md D22.
RESUME_PARSER_PROVIDER=disabled
# Required when RESUME_PARSER_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model id on OpenRouter (verified 2026-10-20)
OPENROUTER_RESUME_MODEL=openai/gpt-4.1-mini
RESUME_PARSER_TIMEOUT_MS=60000
