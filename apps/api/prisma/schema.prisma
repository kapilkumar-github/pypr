// Pypr database schema. Only migrations change the database (decision D6):
// edit this file, then run `pnpm --filter @pypr/api db:migrate --name <change>`.
//
// Conventions: snake_case tables and columns, UUIDv7 primary keys (time-ordered),
// timestamptz with millisecond precision, explicit index names.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A person with an account. Emails are stored lowercased (a CHECK constraint enforces it).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique(map: "uq_users_email") @db.VarChar(320)
  /// argon2id hash (decision D4). Null for accounts that only sign in through a provider.
  passwordHash    String?   @map("password_hash") @db.Text
  /// Set when the user opens the verification link. Sign-in is blocked until then.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  identityProviders IdentityProvider[]
  tokens            UserToken[]
  resumes           Resume[]

  @@map("users")
}

/// One signed-in device or browser. The access token carries this id.
/// Revoking the session ends every refresh token issued for it.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// Every refresh token issued for a session (the "family"). Only the SHA-256 hash is stored.
/// A token is used once: refreshing sets used_at and issues a new one. Presenting a token
/// that already has used_at set is reuse, and revokes the whole session.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// Hex-encoded SHA-256 of the token.
  tokenHash String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}

/// External sign-in providers. Not used yet: only email + password is built (decision D4).
enum IdentityProviderKind {
  linkedin

  @@map("identity_provider_kind")
}

/// Links a user to an account at an external provider.
model IdentityProvider {
  id             String               @id @default(uuid(7)) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  provider       IdentityProviderKind
  providerUserId String               @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "uq_identity_providers_provider_user")
  @@index([userId], map: "idx_identity_providers_user_id")
  @@map("identity_providers")
}

/// What a one-time user token is for.
enum UserTokenPurpose {
  verify_email

  @@map("user_token_purpose")
}

/// One-time tokens sent by email (verification now, password reset later).
/// Only the SHA-256 hash is stored; a token works once and expires.
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  /// Hex-encoded SHA-256 of the token.
  tokenHash String           @unique(map: "uq_user_tokens_token_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "idx_user_tokens_user_purpose")
  @@map("user_tokens")
}

/// A resume (decision D3). Content lives in resume_basics, resume_sections and resume_entries.
/// Saves send the whole document with the revision they edited; a stale revision gets 409.
model Resume {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  title          String        @db.VarChar(120)
  template       String        @db.VarChar(40)
  /// Presentation settings (decision D25); defaults apply to resumes created before they existed.
  accentColor    String        @default("#B7FF3C") @map("accent_color") @db.Char(7)
  font           String        @default("helvetica") @db.VarChar(40)
  density        ResumeDensity @default(normal)
  /// Version of the content shape (RESUME_SCHEMA_VERSION in @pypr/resume-core).
  schemaVersion  Int           @map("schema_version")
  /// Starts at 1 and goes up by one on every save.
  revision       Int           @default(1)
  /// From the Idempotency-Key header of the POST that created it, so retries don't duplicate.
  idempotencyKey String?       @map("idempotency_key") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  basics   ResumeBasics?
  sections ResumeSection[]

  @@unique([userId, idempotencyKey], map: "uq_resumes_user_idempotency_key")
  @@index([userId, updatedAt(sort: Desc)], map: "idx_resumes_user_updated")
  @@map("resumes")
}

/// Contact details and summary: typed columns, one row per resume.
model ResumeBasics {
  resumeId String @id @map("resume_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(120)
  headline String @db.VarChar(160)
  email    String @db.VarChar(320)
  phone    String @db.VarChar(40)
  location String @db.VarChar(120)
  website  String @db.VarChar(300)
  linkedin String @db.VarChar(300)
  github   String @db.VarChar(300)
  summary  String @db.Text

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_basics")
}

enum ResumeSectionType {
  experience
  education
  skills
  projects
  certifications
  awards
  languages
  custom

  @@map("resume_section_type")
}

/// A section of a resume. Ids come from the client so they stay stable across saves.
model ResumeSection {
  id       String            @id @db.Uuid
  resumeId String            @map("resume_id") @db.Uuid
  type     ResumeSectionType
  title    String            @db.VarChar(80)
  position Int
  visible  Boolean

  resume  Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  entries ResumeEntry[]

  @@index([resumeId, position], map: "idx_resume_sections_resume_position")
  @@map("resume_sections")
}

/// One item in a section. `data` is validated against the section type's Zod schema before
/// every write; the database doesn't enforce its shape (decision D3).
model ResumeEntry {
  id        String  @id @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  position  Int
  visible   Boolean
  data      Json    @db.JsonB

  section ResumeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position], map: "idx_resume_entries_section_position")
  @@map("resume_entries")
}

enum ResumeDensity {
  compact
  normal
  spaced

  @@map("resume_density")
}
