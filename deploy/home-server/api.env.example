# Production settings for the API on the home server. Copy to ~/pypr-api/api.env (chmod 600).
# Never commit the real file. See docs/deployment.md.
NODE_ENV=production
HOST=127.0.0.1
PORT=8081

# Supabase PostgreSQL (direct connection; the server has IPv6)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true

# 48+ random bytes, unique to production: openssl rand -base64 48
JWT_ACCESS_SECRET=

# The web app (Vercel). It proxies /api to this API, so the browser never calls it directly.
WEB_ORIGINS=https://pypr.work
APP_URL=https://pypr.work
# Proxies that append X-Forwarded-For before the API: Vercel's rewrite and Cloudflare.
TRUST_PROXY=2

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Pypr <no-reply@send.pypr.work>

RESUME_PARSER_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_RESUME_MODEL=openai/gpt-4.1-mini

PDF_CONCURRENCY=2
