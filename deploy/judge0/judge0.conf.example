# Copy to judge0.conf (gitignored) and change the three CHANGE_ME values.
RAILS_ENV=production
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME

# Learners' code gets no network and small limits (the CPU_, WALL_, MEMORY_ and PROCESSES values below are the defaults
# every run gets). The MAX_ values also apply to compiling, which Go needs room for.
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=15
CPU_EXTRA_TIME=0.5
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=30
MEMORY_LIMIT=131072
MAX_MEMORY_LIMIT=524288
STACK_LIMIT=65536
MAX_STACK_LIMIT=65536
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=120
MAX_FILE_SIZE=20480
MAX_MAX_FILE_SIZE=20480
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
# Only the Go API calls Judge0 and it sets compiler options itself (TypeScript target); learners never do.
ENABLE_COMPILER_OPTIONS=true
ALLOW_ENABLE_COMPILER_OPTIONS=true
ENABLE_WAIT_RESULT=false
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=20
COUNT_OF_WORKERS=4
