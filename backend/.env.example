# Postgres connection (Supabase used as plain Postgres). Keep real values in .env only.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
# Address the API listens on.
ADDR=:8080
# Public URL of the web app, used in emailed links.
APP_URL=http://localhost:3000
# Set true in production (HTTPS) so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# "log" prints emails to the console (dev); "resend" sends through Resend.
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=Pypr <no-reply@send.pypr.work>
# PDF downloads: "chrome" renders the web print page in a local headless Chrome (must be installed).
PDF_PROVIDER=chrome
# Run Chrome without its sandbox (only inside a container that drops all capabilities).
CHROME_NO_SANDBOX=false
# AI features (resume upload, job analysis): "openrouter" uses LLMs on OpenRouter; "none" turns them off.
AI_PROVIDER=none
OPENROUTER_API_KEY=
# Optional comma-separated models, tried in order (default: free Gemma 4 31B, then Nemotron 3.5 Super).
OPENROUTER_MODELS=
